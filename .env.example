# Oracle Database 21c XE Connection
ORACLE_USER=tt_admin
ORACLE_PASSWORD=tt_secret_123
ORACLE_DSN=localhost:1521/XEPDB1
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=

# Backend Server
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Adaptive Checkpoint Engine Policy Defaults
CHECKPOINT_DEFAULT_STRATEGY=ADAPTIVE
ADAPTIVE_CHANGE_THRESHOLD=25
ADAPTIVE_REPLAY_COST_THRESHOLD_MS=12.0
ADAPTIVE_QUERY_FREQ_THRESHOLD=3
STORAGE_BUDGET_MB=250
FIXED_INTERVAL_CHANGES=50

# Benchmark Config
BENCHMARK_OUTPUT_DIR=benchmarks/results
